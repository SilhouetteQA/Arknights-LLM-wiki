  "_description": "剧情分类体系 — 决定每章在 Pass 1/2/3 中的提取策略。保留原 index.json 的 category 字段做向后兼容。",
  "_version": "1.0",
  "_last_updated": "2026-06-17",

  "taxonomy_levels": {
    "full": {
      "label": "全量提取",
      "description": "主线、插曲/支线、故事集 — 全部严格意义上的剧情章节",
      "pass1": "完整的事件/概念/阵营/地点提取",
      "pass2": "完整的实体/关系提取",
      "pass3": "完整 RAG 索引"
    },
    "is": {
      "label": "集成战略",
      "description": "想象世界线/if 线剧情。现有 story nodes 仅为序章+结局标题，主体叙事文本在 PRTS Wiki 子页面中",
      "pass1": "抓取子页面叙事文本（结局完整叙事、月度故事、背景记录）并与 story nodes 合并提取。标记 is_imaginary=true。藏品描述单独提取为物品级别的世界观信息。",
      "pass2": "完整的实体/关系提取（IS 角色可能为主世界对应角色的异格/if版本）",
      "pass3": "标记为非正史来源，低权重 RAG，但世界观相关的侧面信息可纳入主索引",
      "sub_pages": {
        "结局记录页": {
          "priority": "P0",
          "description": "每个 IS 主题的记录仪/宝盒页面，包含 4-6 个结局的完整叙事文本（每个结局 50-100 行，分3部分），远超 story nodes 的一行标题",
          "examples": ["深蓝记录仪", "长生者宝盒", "极夜展览馆", "发散思维记录", "墨卷集成"],
          "content_per_theme": "200-600 行叙事文本"
        },
        "月度故事": {
          "priority": "P0",
          "description": "月度小队/追忆映射/探索者档案，每月一篇完整短篇故事",
          "examples": ["万象追忆录", "追忆映射", "探索者档案"],
          "content_per_theme": "6-12 篇 x 30-80 行 = 180-800 行"
        },
        "背景故事记录": {
          "priority": "P0",
          "description": "世界观揭示、碑文记录、审判庭文档、回响文本等",
          "examples": ["壳中回响", "启示", "刻时碑林", "符号认知空间", "审判庭记录", "故事的引言", "石碑的记录", "大群的呼唤"],
          "content_per_theme": "100-300 行"
        },
        "藏品描述": {
          "priority": "P1",
          "description": "带世界观描述的物品，每个 1-3 句，结构化表格",
          "examples": ["猩红珍藏", "生物制品陈设", "仪式物品陈设", "钱木记", "收藏品图鉴"],
          "content_per_theme": "600-700 条"
        },
        "事件一览": {
          "priority": "P1",
          "description": "节点遭遇的微型故事，包含场景描述+NPC对白+选项分支",
          "content_per_theme": "200-240 个事件"
        }
      }
    },
    "ra": {
      "label": "生息演算",
      "description": "游戏机制驱动的特殊支线，与主线有交叉",
      "pass1": "完整的事件提取",
      "pass2": "提取基地/食物/工具描述中的文化/世界观信息",
      "pass3": "正常 RAG 索引，注明 gameplay_linked=true"
    },
    "light": {
      "label": "轻量提取",
      "description": "愚人节/搞笑/综艺类 — 信息密度极低",
      "pass1": "仅提取基本事件",
      "pass2": "跳过",
      "pass3": "跳过"
    },
    "skip": {
      "label": "跳过",
      "description": "纯战斗/系统页面/序曲/隐藏剧情 — 无叙事内容",
      "pass1": "跳过",
      "pass2": "跳过",
      "pass3": "跳过"
    }
  },

